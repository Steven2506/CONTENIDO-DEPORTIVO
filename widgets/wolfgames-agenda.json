{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "bleed": true,
      "items": [
        {"type": "TextBlock", "text": "WOLFGAMES · DEPORTES", "size": "Small", "weight": "Bolder", "color": "Accent", "wrap": true},
        {"type": "TextBlock", "text": "${headline}", "size": "Large", "weight": "Bolder", "wrap": true},
        {"type": "TextBlock", "text": "${headlineDetail}", "size": "Small", "isSubtle": true, "wrap": true}
      ]
    },
    {"type": "TextBlock", "text": "${item1Title}", "weight": "Bolder", "wrap": true, "spacing": "Medium"},
    {"type": "TextBlock", "text": "${item1Detail}", "size": "Small", "isSubtle": true, "wrap": true, "spacing": "None"},
    {"type": "TextBlock", "text": "${item2Title}", "weight": "Bolder", "wrap": true, "spacing": "Medium"},
    {"type": "TextBlock", "text": "${item2Detail}", "size": "Small", "isSubtle": true, "wrap": true, "spacing": "None"},
    {"type": "TextBlock", "text": "${item3Title}", "weight": "Bolder", "wrap": true, "spacing": "Medium"},
    {"type": "TextBlock", "text": "${item3Detail}", "size": "Small", "isSubtle": true, "wrap": true, "spacing": "None"}
  ],
  "actions": [
    {"type": "Action.OpenUrl", "title": "Abrir WOLFGAMES", "url": "${url}"}
  ]
}
